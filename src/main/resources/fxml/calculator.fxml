<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ggast.calculator.CalculatorController"
      spacing="10"
      alignment="CENTER">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <children>

        <TextField
                fx:id="display"
                styleClass="display"
                editable="false"
                text="0"
                prefHeight="60"/>

        <GridPane hgap="5" vgap="5">

            <!-- Row 1 -->
            <Button text="7" styleClass="number-button" onAction="#handleNumber"
                    GridPane.columnIndex="0" GridPane.rowIndex="0"/>

            <Button text="8" styleClass="number-button" onAction="#handleNumber"
                    GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Button text="9" styleClass="number-button" onAction="#handleNumber"
                    GridPane.columnIndex="2" GridPane.rowIndex="0"/>

            <Button text="÷" styleClass="operator-button" onAction="#handleOperator"
                    GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <!-- Row 2 -->
            <Button text="4" styleClass="number-button" onAction="#handleNumber"
                    GridPane.columnIndex="0" GridPane.rowIndex="1"/>

            <Button text="5" styleClass="number-button" onAction="#handleNumber"
                    GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Button text="6" styleClass="number-button" onAction="#handleNumber"
                    GridPane.columnIndex="2" GridPane.rowIndex="1"/>

            <Button text="×" styleClass="operator-button" onAction="#handleOperator"
                    GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <!-- Row 3 -->
            <Button text="1" styleClass="number-button" onAction="#handleNumber"
                    GridPane.columnIndex="0" GridPane.rowIndex="2"/>

            <Button text="2" styleClass="number-button" onAction="#handleNumber"
                    GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Button text="3" styleClass="number-button" onAction="#handleNumber"
                    GridPane.columnIndex="2" GridPane.rowIndex="2"/>

            <Button text="-" styleClass="operator-button" onAction="#handleOperator"
                    GridPane.columnIndex="3" GridPane.rowIndex="2"/>

            <!-- Row 4 -->
            <Button text="0" styleClass="number-button" onAction="#handleNumber"
                    GridPane.columnIndex="0" GridPane.rowIndex="3"/>

            <Button text="." styleClass="number-button" onAction="#handleDecimal"
                    GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <Button text="=" styleClass="equal-button" onAction="#handleEquals"
                    GridPane.columnIndex="2" GridPane.rowIndex="3"/>

            <Button text="+" styleClass="operator-button" onAction="#handleOperator"
                    GridPane.columnIndex="3" GridPane.rowIndex="3"/>

            <!-- Row 5 -->
            <Button text="C"
                    styleClass="clear-button"
                    onAction="#handleClear"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="4"
                    GridPane.columnSpan="4"
                    maxWidth="Infinity"/>

        </GridPane>

    </children>

</VBox>